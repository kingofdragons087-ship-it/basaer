<!doctype html>
<html lang="ar" dir="rtl">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>حسابي | البصائر</title>
<style>body{font-family:Arial;background:#f2f7fc;color:#17324d;padding:25px}.card{max-width:600px;margin:40px auto;background:white;padding:25px;border-radius:18px}img{width:72px;height:72px;border-radius:50%}a,button{display:inline-block;padding:12px 18px;border:0;border-radius:10px;background:#1676a8;color:white;text-decoration:none;cursor:pointer;margin:8px 0}</style></head>
<body><main class="card"><h1>حسابي في البصائر</h1>
<% if (user.avatar_url) { %><img src="<%= user.avatar_url %>" alt="الصورة الشخصية"><% } %>
<h2><%= user.display_name %></h2><p><%= user.email %></p>
<p>نوع الحساب: <%= user.role === "owner" ? "المالك" : user.role === "admin" ? "مدير" : "مستخدم" %></p>
<a href="/">الصفحة الرئيسية</a>
<% if (user.role === "owner") { %><a href="/owner">لوحة المالك</a><% } %>
<form method="post" action="/logout"><button type="submit">تسجيل الخروج</button></form>
</main></body></html>