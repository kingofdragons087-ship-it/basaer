<!DOCTYPE html>
<html lang="ar" dir="rtl" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#f6f9ff">
  <meta name="application-name" content="البصائر">
  <title><%= reciter.name %> | البصائر</title>
  <link rel="icon" href="/icon.jpeg">
  <link rel="manifest" href="/manifest.json">
  <link rel="stylesheet" href="/style.css">
  <script src="/theme.js" defer></script>
</head>
<body>
  <header class="topbar">
    <a class="brand" href="/" aria-label="البصائر الرئيسية">
      <span class="brand-mark"><img src="/icon.jpeg" alt="شعار البصائر"></span>
      <span class="brand-name">البصائر<small>مساحة للصوت والسكينة</small></span>
    </a>
    <nav class="navigation">
      <a href="/">الرئيسية</a>
      <a href="#recordings">التلاوات</a>
      <% if (videos.length) { %><a href="#videos">الفيديوهات</a><% } %>
    </nav>
    <div class="header-actions">
      <button class="theme-toggle" id="themeToggle" type="button"
        aria-label="تغيير المظهر" title="تغيير المظهر">
        <span id="themeIcon">☾</span>
      </button>
      <a class="header-button" href="/">العودة للرئيسية ↙</a>
    </div>
  </header>

  <style>
    .reciter-page {
      position: relative;
      isolation: isolate;
      background: #080b10;
      min-height: 100vh;
    }
    .reciter-page::before {
      content: "";
      position: fixed;
      inset: 0;
      z-index: -1;
      pointer-events: none;
      background-image:
        linear-gradient(rgba(5, 9, 16, .76), rgba(5, 9, 16, .88)),
        var(--reciter-cover);
      background-size: contain;
      background-position: center top;
      background-repeat: no-repeat;
    }
    .basaer-reciter-cover {
      position: relative;
      width: min(1100px, 100%);
      margin: 0 auto 20px;
      padding: 20px 20px 12px;
      box-sizing: border-box;
      background: transparent;
      border: 0;
      border-radius: 0;
      box-shadow: none;
      color: #fff;
      text-align: center;
    }
    .basaer-bismillah {font-size:clamp(22px,4vw,32px);line-height:1.7;margin:0 0 16px;color:#fff;text-shadow:0 2px 12px rgba(0,0,0,.45)}
    .basaer-reciter-cover .reciter-profile {margin:0;padding:0;background:transparent;border:0;box-shadow:none}
    .basaer-reciter-cover .reciter-profile-info h1,
    .basaer-reciter-cover .reciter-profile-info p,
    .basaer-reciter-cover .section-kicker {color:#fff}
    .basaer-reciter-cover .reciter-profile-stats span {color:#fff}
    .basaer-reciter-cover .reciter-profile-image {border:3px solid #ffffffa8}
    .basaer-tabs {display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin:0 auto 24px;width:min(1100px,94%)}
    .basaer-tab {border:1px solid var(--border,#dce5ef);border-radius:13px;padding:12px 18px;background:var(--card-bg,#fff);color:inherit;font:inherit;font-weight:750;cursor:pointer}
    .basaer-tab[aria-selected="true"] {background:#175c91;color:white;border-color:#175c91}
    html[data-theme="dark"] .basaer-tab:not([aria-selected="true"]) {
      background: #111824;
      color: #edf2ff;
      border-color: #293448;
    }
    .basaer-tab-panel[hidden] {display:none!important}
    .basaer-wave {height:36px;display:flex;align-items:center;justify-content:center;gap:3px;margin:12px 0;overflow:hidden}
    .basaer-wave span {display:block;width:3px;height:8px;border-radius:5px;background:#4c91cf;opacity:.85}
    .recording-card.is-playing .basaer-wave span {animation:basaerWave .7s ease-in-out infinite alternate}
    .recording-card.is-playing .basaer-wave span:nth-child(3n) {animation-delay:-.3s}
    .recording-card.is-playing .basaer-wave span:nth-child(3n + 1) {animation-delay:-.5s}
    @keyframes basaerWave {from{height:5px}to{height:32px}}
    .basaer-video-number {display:inline-grid;place-items:center;min-width:30px;height:30px;border-radius:9px;background:#175c91;color:#fff;margin:12px 0 0;font-weight:800}
    @media(max-width:600px){.basaer-reciter-cover{padding:14px 12px 8px;margin-bottom:16px}.basaer-bismillah{margin-bottom:12px}.basaer-tab{flex:1;padding:11px 8px;font-size:13px}}
    @media(prefers-reduced-motion:reduce){.recording-card.is-playing .basaer-wave span{animation:none;height:12px}}
  </style>
  <!-- BASAER_RECITER_TABS_V1 -->
  <main class="reciter-page"<% if (reciter.background_url) { %> style="--reciter-cover: url(&quot;<%= reciter.background_url %>&quot;);"<% } %>>
    <section class="basaer-reciter-cover">
      <p class="basaer-bismillah">بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ</p>
      <section class="reciter-profile">
      <div class="reciter-profile-image">
        <% if (reciter.image_url) { %>
          <img src="<%= reciter.image_url %>"
            alt="صورة القارئ <%= reciter.name %>">
        <% } else { %>
          <span aria-hidden="true">♫</span>
        <% } %>
      </div>
      <div class="reciter-profile-info">
        <span class="section-kicker">من مكتبة البصائر</span>
        <h1><%= reciter.name %></h1>
        <% if (reciter.biography) { %>
          <p><%= reciter.biography %></p>
        <% } else { %>
          <p>استمع إلى التلاوات الصوتية واختر ما تحب الاستماع إليه.</p>
        <% } %>
        <div class="reciter-profile-stats">
          <span><strong><%= recordings.length %></strong> تلاوة</span>
          <span><strong><%= videos.length %></strong> فيديو</span>
        </div>
      </div>
      </section>
    </section>

    <div class="basaer-tabs" role="tablist" aria-label="نوع محتوى القارئ">
      <button class="basaer-tab" id="basaer-audio-tab" type="button" role="tab"
        aria-controls="basaer-audio-panel" aria-selected="true">تحميل أو استمع للصوت</button>
      <button class="basaer-tab" id="basaer-video-tab" type="button" role="tab"
        aria-controls="basaer-video-panel" aria-selected="false">تحميل أو مشاهدة فيديو</button>
    </div>

    <div id="basaer-audio-panel" class="basaer-tab-panel" role="tabpanel" aria-labelledby="basaer-audio-tab">
    <section class="reciter-content-section" id="recordings">
      <div class="section-heading">
        <div>
          <span class="section-kicker">استمع بقلبك</span>
          <h2>التسجيلات الصوتية</h2>
        </div>
        <span class="coming-badge"><span></span> <%= recordings.length %> تلاوة</span>
      </div>

      <% if (recordings.length) { %>
        <div class="recordings-list">
          <% recordings.forEach((recording) => { %>
            <article class="recording-card">
              <div class="recording-heading">
                <span class="recording-number"><%= recording.surah_number %></span>
                <div class="recording-title">
                  <h3><%= recording.surah_name %></h3>
                  <span>سورة رقم <%= recording.surah_number %></span>
                </div>
                <% if (recording.duration_seconds !== null) { %>
                  <span class="recording-duration">
                    <%= Math.floor(recording.duration_seconds / 60) %>:<%= String(recording.duration_seconds % 60).padStart(2, "0") %>
                  </span>
                <% } %>
              </div>
              <div class="basaer-wave" aria-hidden="true">
                <% for (let wave = 0; wave < 42; wave++) { %><span></span><% } %>
              </div>
              <audio controls preload="none">
                <source src="<%= recording.audio_url %>">
                متصفحك لا يدعم تشغيل الصوت.
              </audio>
              <% if (recording.download_enabled) { %>
                <a class="recording-download"
                   href="<%= recording.audio_url %>"
                   download
                   target="_blank"
                   rel="noopener noreferrer">
                  <span aria-hidden="true">↓</span> تنزيل التسجيل
                </a>
              <% } %>
            </article>
          <% }) %>
        </div>
      <% } else { %>
        <div class="library-empty">
          <div class="empty-icon">♫</div>
          <h3>لا توجد تسجيلات منشورة بعد</h3>
          <p>ستظهر التلاوات هنا عند إضافتها ونشرها في المكتبة.</p>
        </div>
      <% } %>
    </section>

    </div>
    <div id="basaer-video-panel" class="basaer-tab-panel" role="tabpanel" aria-labelledby="basaer-video-tab" hidden>
    <% if (videos.length) { %>
      <section class="reciter-content-section" id="videos">
        <div class="section-heading">
          <div>
            <span class="section-kicker">شاهد واستمع</span>
            <h2>فيديوهات القارئ</h2>
          </div>
          <span class="coming-badge"><span></span> <%= videos.length %> فيديو</span>
        </div>
        <div class="reciter-videos-grid">
          <% videos.forEach((video) => { %>
            <article class="reciter-video-card">
              <span class="basaer-video-number"><%= videos.indexOf(video) + 1 %></span>
              <div class="reciter-video-frame">
                <iframe
                  src="https://www.youtube-nocookie.com/embed/<%= video.youtube_video_id %>"
                  title="<%= video.title || ('تلاوة للقارئ ' + reciter.name) %>"
                  loading="lazy"
                  referrerpolicy="strict-origin-when-cross-origin"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                  allowfullscreen></iframe>
              </div>
              <% if (video.title) { %>
                <h3><%= video.title %></h3>
              <% } %>
            </article>
          <% }) %>
        </div>
      </section>
    <% } %>
    </div>
  </main>

  <script>
    (() => {
      const audioTab = document.getElementById("basaer-audio-tab");
      const videoTab = document.getElementById("basaer-video-tab");
      const audioPanel = document.getElementById("basaer-audio-panel");
      const videoPanel = document.getElementById("basaer-video-panel");

      function activate(which) {
        const audioActive = which === "audio";
        audioTab.setAttribute("aria-selected", String(audioActive));
        videoTab.setAttribute("aria-selected", String(!audioActive));
        audioPanel.hidden = !audioActive;
        videoPanel.hidden = audioActive;
      }

      audioTab.addEventListener("click", () => activate("audio"));
      videoTab.addEventListener("click", () => activate("video"));

      document.querySelectorAll(".recording-card").forEach(card => {
        const audio = card.querySelector("audio");
        if (!audio) return;
        audio.addEventListener("play", () => {
          document.querySelectorAll(".recording-card").forEach(other => {
            other.classList.remove("is-playing");
            if (other !== card) {
              const otherAudio = other.querySelector("audio");
              if (otherAudio) otherAudio.pause();
            }
          });
          card.classList.add("is-playing");
        });
        const stopWave = () => card.classList.remove("is-playing");
        audio.addEventListener("pause", stopWave);
        audio.addEventListener("ended", stopWave);
      });
    })();
  </script>

  <footer class="footer">
    <a class="brand footer-brand" href="/">
      <span class="brand-mark"><img src="/icon.jpeg" alt="شعار البصائر"></span>
      <span class="brand-name">البصائر<small>مساحة للصوت والسكينة</small></span>
    </a>
    <span>نسأل الله أن يجعل هذا العمل نافعًا.</span>
    <span>© البصائر</span>
  </footer>
</body>
</html>
