<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#f4f8ff">
  <meta name="description" content="البصائر، مساحة عربية للاستماع إلى تلاوات القرآن الكريم.">
  <title>البصائر | أنصت بقلبك</title>
  <link rel="stylesheet" href="/style.css">
  <link rel="manifest" href="/manifest.json">
  <link rel="icon" type="image/jpeg" href="/icon.jpeg">
  <link rel="apple-touch-icon" href="/icon.jpeg">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="application-name" content="البصائر">
  <script src="/theme.js" defer></script>
</head>
<body>
  <header class="topbar">
    <a class="brand" href="/" aria-label="البصائر الرئيسية">
      <span class="brand-mark"><img src="/icon.jpeg" alt="شعار البصائر"></span>
      <span class="brand-name">البصائر<small>مساحة للصوت والسكينة</small></span>
    </a>
    <nav class="navigation">
      <a href="#home">الرئيسية</a>
      <a href="#library">المكتبة الصوتية</a>
      <a href="#about">عن البصائر</a>
    </nav>
    <div class="header-actions">
      <button class="theme-toggle" id="themeToggle" type="button" aria-label="تفعيل الوضع الليلي" title="تغيير المظهر">
        <span id="themeIcon">☾</span>
      </button>
      <% if (currentUser) { %>
        <a class="header-button" href="/account" id="accountOpenBtn" aria-haspopup="dialog" aria-controls="accountModal">حسابي</a>
        <% if (currentUser.role === "owner") { %>
          <a class="header-button" href="/owner">لوحة المالك</a>
        <% } %>
      <% } else { %>
        <a class="header-button" href="/auth/google">تسجيل الدخول بـ Google</a>
      <% } %>
      <a class="header-button" href="#library">استكشف المكتبة ↙</a>
    </div>
  </header>

  <main>
    <section class="hero" id="home">
      <div class="hero-content">
        <div class="eyebrow"><span></span> تلاوات قرآنية • تجربة هادئة</div>
        <h1>أنصت بقلبك،<br>واكتشف <span>البصائر.</span></h1>
        <p class="hero-description">
          مساحة عربية تجمعك بالتلاوات الصوتية في تجربة بسيطة وهادئة،
          لتمنح وقت استماعك مزيدًا من الصفاء والسكينة.
        </p>
        <div class="hero-actions">
          <a class="primary-button" href="#library">استكشف المكتبة <span>←</span></a>
          <a class="text-button" href="#about">اكتشف فكرة البصائر</a>
        </div>
        <div class="hero-note">
          <span class="note-icon">♫</span>
          <span><strong>الصوت أولًا</strong><small>تجربة مصممة للاستماع دون تشتيت</small></span>
        </div>
      </div>

      <div class="hero-art" aria-hidden="true">
        <div class="art-glow"></div>
        <div class="art-orbit orbit-one"></div>
        <div class="art-orbit orbit-two"></div>
        <div class="art-card">
          <div class="art-top"><span>البصائر</span><span>۞</span></div>
          <div class="art-emblem">﷽</div>
          <div class="art-lines"><i></i><i></i><i></i></div>
          <div class="art-wave"><b></b><b></b><b></b><b></b><b></b><b></b><b></b><b></b><b></b><b></b><b></b><b></b><b></b><b></b><b></b></div>
          <div class="art-caption">لحظات من الهدوء والسكينة</div>
        </div>
        <span class="floating-dot dot-one"></span>
        <span class="floating-dot dot-two"></span>
      </div>
    </section>

    <section class="features" aria-label="مميزات البصائر">
      <article class="feature">
        <span class="feature-icon">♫</span>
        <div><h3>الصوت أولًا</h3><p>مساحة مخصصة للاستماع إلى التلاوات.</p></div>
      </article>
      <article class="feature">
        <span class="feature-icon">⌕</span>
        <div><h3>اكتشاف أسهل</h3><p>مكتبة منظمة تساعدك على الوصول إلى القراء.</p></div>
      </article>
      <article class="feature">
        <span class="feature-icon">✧</span>
        <div><h3>بساطة وهدوء</h3><p>واجهة عربية واضحة على الهاتف والحاسوب.</p></div>
      </article>
    </section>

    <section class="library-section" id="library">
      <div class="section-heading">
        <div>
          <span class="section-kicker">مساحتك الصوتية</span>
          <h2>المكتبة الصوتية</h2>
        </div>
        <span class="coming-badge">
          <span></span>
          <%= reciters && reciters.length ? "اكتشف القراء" : "قيد التجهيز" %>
        </span>
      </div>

      <% if (reciters && reciters.length) { %>
        <div class="reciters-grid">
          <% reciters.forEach((reciter) => { %>
            <a class="reciter-card" href="/reciters/<%= encodeURIComponent(reciter.slug) %>">
              <div class="reciter-card-image">
                <% if (reciter.image_url) { %>
                  <img
                    src="<%= reciter.image_url %>"
                    alt="صورة القارئ <%= reciter.name %>"
                    loading="lazy"
                  >
                <% } else { %>
                  <span class="reciter-image-placeholder" aria-hidden="true">♫</span>
                <% } %>
              </div>
              <div class="reciter-card-content">
                <h3><%= reciter.name %></h3>
                <p>
                  <%= reciter.recordings_count %> تلاوة
                  <span aria-hidden="true">·</span>
                  <%= reciter.videos_count %> فيديو
                </p>
                <span class="reciter-card-link">استكشف التلاوات <span aria-hidden="true">←</span></span>
              </div>
            </a>
          <% }) %>
        </div>
      <% } else { %>
        <div class="library-empty">
          <div class="empty-icon">♫</div>
          <h3>هنا تبدأ رحلتك مع التلاوات</h3>
          <p>نعمل على تجهيز المكتبة وإضافة القراء والتسجيلات الصوتية.</p>
          <span class="empty-footnote">لن نعرض تسجيلات وهمية؛ ستظهر المحتويات عند إضافتها فعليًا.</span>
        </div>
      <% } %>
    </section>

    <section class="about-section" id="about">
      <div class="about-symbol"><img src="/icon.jpeg" alt="شعار البصائر"></div>
      <div><span class="section-kicker">عن المنصة</span><h2>صُممت لتستمع براحة.</h2>
      <p>البصائر مشروع عربي مستقل، هدفه تقديم تجربة استماع سهلة وهادئة لتسجيلات القرآن الكريم، مع تنظيم القراء والتلاوات في مكان واحد.</p></div>
    </section>
  </main>

  <footer class="footer">
    <a class="brand footer-brand" href="/"><span class="brand-mark"><img src="/icon.jpeg" alt="شعار البصائر"></span><span class="brand-name">البصائر<small>مساحة للصوت والسكينة</small></span></a>
    <span>نسأل الله أن يجعل هذا العمل نافعًا.</span>
    <span>© البصائر</span>
  </footer>


  <% if (currentUser) { %>
  <div class="account-modal-overlay" id="accountModal" hidden>
    <section class="account-modal-card" role="dialog" aria-modal="true" aria-labelledby="accountModalTitle" dir="rtl">
      <button class="account-modal-close" id="accountCloseBtn" type="button" aria-label="إغلاق">×</button>
      <div class="account-modal-heading">
        <% if (currentUser.avatar_url) { %>
          <img class="account-modal-avatar" src="<%= currentUser.avatar_url %>" alt="الصورة الشخصية">
        <% } else { %>
          <div class="account-modal-avatar account-modal-avatar-fallback" aria-hidden="true">♙</div>
        <% } %>
        <div class="account-modal-identity">
          <h2 id="accountModalTitle"><%= currentUser.display_name %></h2>
          <p class="account-modal-email"><%= currentUser.email %></p>
          <span class="account-modal-role"><%= currentUser.role === "owner" ? "♛ المالك" : currentUser.role === "admin" ? "مدير" : "مستخدم" %></span>
        </div>
      </div>
      <div class="account-modal-divider"></div>
      <div class="account-modal-actions">
        <% if (currentUser.role === "owner") { %>
          <a class="account-modal-primary" href="/owner">لوحة المالك ←</a>
        <% } %>
        <form method="post" action="/logout">
          <button class="account-modal-logout" type="submit">تسجيل الخروج</button>
        </form>
      </div>
      <p class="account-modal-footnote">البصائر · مساحة للصوت والسكينة</p>
    </section>
  </div>
  <% } %>

  <script>
  (() => {
    const modal = document.getElementById("accountModal");
    const openBtn = document.getElementById("accountOpenBtn");
    const closeBtn = document.getElementById("accountCloseBtn");
    if (!modal || !openBtn || !closeBtn) return;

    function openAccount(event) {
      event.preventDefault();
      modal.hidden = false;
      document.body.classList.add("account-modal-open");
      closeBtn.focus();
    }

    function closeAccount() {
      modal.hidden = true;
      document.body.classList.remove("account-modal-open");
      openBtn.focus();
    }

    openBtn.addEventListener("click", openAccount);
    closeBtn.addEventListener("click", closeAccount);
    modal.addEventListener("click", event => {
      if (event.target === modal) closeAccount();
    });
    document.addEventListener("keydown", event => {
      if (event.key === "Escape" && !modal.hidden) closeAccount();
    });
  })();
  </script>

</body>
</html>
